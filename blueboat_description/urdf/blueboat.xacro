<?xml version="1.0"?>
<robot name="blueboat" xmlns:xacro="http://www.ros.org/wiki/xacro" >
    
  <xacro:arg name="namespace" default="blueboat"/>
  <!-- thruster joints are fixed if not for gazebo use -->
  <xacro:arg name="simulation" default="true"/>
  
  <xacro:arg name="density" default="1000"/>
  <!-- Kinematic replay of a recorded run (v1.1, blueboat_control Replay_launch.py):
       no hydrodynamics, no thruster plugins, no collision geometry (the world's
       Buoyancy acts on collision volumes) and no gravity, so NO force can act on
       the boat - sea state, wind and current cannot move it, and the replay's
       /world/<w>/set_pose calls are clean teleports. -->
  <xacro:arg name="replay" default="false"/>
  <!-- Hull and actuator model (2026-11-13):
         identified        the BlueBoat plant identified on field logs (hydrodynamics_identified.xacro) - default
         bluerov2_legacy   the BlueROV2 table every simulation used before that date (hydrodynamics.xacro);
                           with it this description is the one of before, element for element.
       A replay description (replay:=true) carries no plant at all and is the same for both. -->
  <xacro:arg name="plant" default="identified"/>
  <!-- Who owns heave / roll / pitch of the identified plant (2026-11-15, session 04b, R-8). The legacy plant ignores it.
         sea_node (default)  BlueBoat-SSS-Sim's sea-state node: the CAD catamaran's hydrostatics and all of the vertical
                             damping (every world run, full_mission_launch.py). The CoG is the derived physical one.
         standalone          no sea node (blueboat_control Sim_launch.py): Gazebo's buoyancy box is the hull, the
                             Hydrodynamics plugin carries the damping, and the CoG stays at the box construction,
                             which keeps that box upright (on the box the physical CoG has a roll GM of -0.025 m).
                             A sea node started beside it (MCS) sizes its damping as the complement: damped once. -->
  <xacro:arg name="vertical_model" default="sea_node"/>
  
  <xacro:property name="ns" value="$(arg namespace)"/>
  <xacro:property name="density" value="$(arg density)"/>
  <xacro:property name="plant" value="$(arg plant)"/>
  <xacro:property name="replay_description" value="$(arg replay)"/>
  <xacro:property name="vertical_model" value="$(arg vertical_model)"/>
  <xacro:if value="${vertical_model not in ('sea_node', 'standalone')}">
    <xacro:element xacro:name="${xacro.fatal('blueboat.xacro: vertical_model must be sea_node or standalone')}"/>
  </xacro:if>
  <xacro:if value="${plant not in ('identified', 'bluerov2_legacy')}">
    <xacro:element xacro:name="${xacro.fatal('blueboat.xacro: plant must be identified or bluerov2_legacy')}"/>
  </xacro:if>
  <xacro:property name="legacy_inertial" value="${plant == 'bluerov2_legacy' or str(replay_description).lower() == 'true'}"/>

  <!-- Main body -->    
  <xacro:property name="x_size" value="1.2"/>
  <xacro:property name="y_size" value="0.91"/>
  <xacro:property name="z_size" value="0.376"/>

  <xacro:property name="mass" value="16.01"/>
      
  <!-- other props -->
  <xacro:property name="prop_mass" value="0.07"/>
  
  <!-- to set correct buoyancy volume with 1 % positive factor -->
  <xacro:property name="buoyant_correction" value="${1.01*pow((mass + 2*prop_mass)/(density*x_size*y_size*z_size), 1./3)}"/>
  <!-- Center of buoyancy -->
  <xacro:property name="z_cob" value="${-buoyant_correction*z_size/4}"/>
  <!-- Center of gravity -->
  <xacro:property name="z_cog" value="${-buoyant_correction*z_size}"/>
  <!-- Identified plant, vertical_model:=sea_node: the physical CoG (2026-11-15, session 04b), DERIVED from a mass budget
       (vendor masses, CAD hull shell, ASSUMED densities and placements; docs/PARAMETER_REGISTER.md s3):
       0.239 m above the keel [0.198, 0.279], keel at link z -0.101 (link origin 0.111 m below the waterline,
       CAD draft 0.212 m) -> +0.138 [+0.097, +0.178]. -->
  <xacro:property name="z_cog_physical" value="0.1376"/>
  <xacro:property name="z_cog_identified" value="${z_cog_physical if vertical_model == 'sea_node' else z_cog}"/>
  
  <xacro:property name="visual_mesh_file" value="package://blueboat_description/meshes/BlueBoat.dae"/>
  <xacro:property name="collision_mesh_file" value="package://blueboat_description/meshes/BlueBoat.stl"/>

  <!-- Vehicle base link -->
    <link name="${ns}/base_link">
    <xacro:if value="${legacy_inertial}">
    <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 ${z_cog}" rpy = "${pi/2} 0 0"/>

    <!-- Inertia computed from .stl file (likely incorrect)-->   
        <!-- <inertia ixx="100.338" ixy="1.223" ixz="-3.53" iyy="70.777" iyz="1.188" izz="149.489"/> -->
    <!-- https://github.com/markusbuchholz/gazebosim_blueboat_ardupilot_sitl/blob/main/SITL_Models/Gazebo/models/blueboat/model.sdf -->
        <inertia ixx="2.42369" ixy="0" ixz="0" iyy="3.9235025" iyz="0" izz="5.6403125"/>
        
    </inertial>
    </xacro:if>
    <xacro:unless value="${legacy_inertial}">
    <!-- Identified plant. The inertial frame is rolled by pi/2, so the link's YAW axis is this block's iyy,
         roll = ixx, pitch = izz (link frame = R_x(pi/2) diag(ixx, iyy, izz) R_x^T = (ixx, izz, iyy)).
         YAW: the identified TOTAL is 9.48 kg.m2 (rigid + added, 95 % [8.11, 10.95]); Gazebo rejects a rigid tensor with
         iyy > ixx + izz, so 7.50 is carried here and 1.98 as nDotR (session 04, unchanged).
         ROLL / PITCH (2026-11-15, R-8, FORCED): rigid 2.42369 / 5.6403125 (third-party model file) + R-8's added
         inertias A44 1.79 / A55 0.93 = 4.21369 / 6.5703125. Carried here, not as kDotP / mDotQ, because the plugin's
         explicit added-mass term is unstable with them (spectral radius 1.15 - 1.30 at the link origin; roll diverged
         in Gazebo at 12 s). I + A is R-8's; lost: the Coriolis terms of A44 and A55. -->
    <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 ${z_cog_identified}" rpy = "${pi/2} 0 0"/>
        <inertia ixx="4.21369" ixy="0" ixz="0" iyy="7.50" iyz="0" izz="6.5703125"/>
    </inertial>
    </xacro:unless>
    <visual>
        <origin xyz="0 -0.01 ${z_cog+0.25}" rpy = "${pi/2} 0 0"/>
        <geometry>
        <mesh filename="${visual_mesh_file}"/>
        </geometry>
        <material name="Moray Green">
            <color rgba="0.83 0.89 0.22 1"/>
        </material>
    </visual>
    
    <xacro:unless value="$(arg replay)">
    <collision>
        <origin xyz="0 0 0.05"/>
        <!-- Box adjusted for buoyancy -->
        <geometry>
            <box size="${x_size*buoyant_correction} ${y_size*buoyant_correction} ${z_size*buoyant_correction}"/>
        </geometry>
    </collision>
    </xacro:unless>

<!--    <gazebo>
        <velocity_decay>
            <linear>-250.15 -70.364 -170.955</linear>
            <angular>1.888 0.761 3.744</angular>
        </velocity_decay>
</gazebo>-->
        
    </link>
  
<xacro:unless value="$(arg replay)">
<xacro:if value="${plant == 'bluerov2_legacy'}">
<xacro:include filename="hydrodynamics.xacro"/>
</xacro:if>
<xacro:unless value="${plant == 'bluerov2_legacy'}">
<xacro:include filename="hydrodynamics_identified.xacro"/>
</xacro:unless>
</xacro:unless>
<xacro:include filename="$(arg thrusters).xacro"/>

<xacro:if value="$(arg replay)">
    <!-- Velocity pinned to zero every physics step (VelocityControl with no
         command holds 0): a force that still reaches the hull - the simulator's
         sea-state wrench (ApplyLinkWrench) - cannot build up a velocity between
         two set_pose calls, which do not reset velocity themselves. A static
         model is not an option: set_pose does not hold one. -->
    <gazebo>
        <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    </gazebo>
    <gazebo reference="${ns}/base_link"><gravity>0</gravity></gazebo>
    <gazebo reference="${ns}/thruster1"><gravity>0</gravity></gazebo>
    <gazebo reference="${ns}/thruster2"><gravity>0</gravity></gazebo>
    <gazebo reference="${ns}/thruster3"><gravity>0</gravity></gazebo>
</xacro:if>

  
<!-- other Gazebo plugins -->
<xacro:if value="$(arg simulation)">
    <gazebo>
        <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
        
        <plugin
            filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
            <odom_frame>world</odom_frame>
            <dimensions>3</dimensions>
            <robot_base_frame>${ns}/base_link</robot_base_frame>
            <odom_publish_frequency>20</odom_publish_frequency>
        </plugin>
        
        <plugin
            filename="ignition-gazebo-pose-publisher-system"
            name="ignition::gazebo::systems::PosePublisher">
            <publish_link_pose>false</publish_link_pose>
            <publish_collision_pose>false</publish_collision_pose>
            <publish_visual_pose>false</publish_visual_pose>
            <publish_nested_model_pose>true</publish_nested_model_pose>
        </plugin>
    </gazebo>
</xacro:if>


</robot>