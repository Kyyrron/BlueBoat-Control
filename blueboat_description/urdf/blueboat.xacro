<?xml version="1.0"?>
<robot name="blueboat" xmlns:xacro="http://www.ros.org/wiki/xacro" >
    
  <xacro:arg name="namespace" default="blueboat"/>
  <!-- thruster joints are fixed if not for gazebo use -->
  <xacro:arg name="simulation" default="true"/>
  
  <xacro:arg name="density" default="1000"/>
  <!-- Kinematic replay of a recorded run (v1.1, blueboat_control Replay_launch.py):
       no hydrodynamics, no thruster plugins, no collision geometry (the world's
       Buoyancy acts on collision volumes) and no gravity, so NO force can act on
       the boat - sea state, wind and current cannot move it, and the replay's
       /world/<w>/set_pose calls are clean teleports. -->
  <xacro:arg name="replay" default="false"/>
  
  <xacro:property name="ns" value="$(arg namespace)"/>
  <xacro:property name="density" value="$(arg density)"/>

  <!-- Main body -->    
  <xacro:property name="x_size" value="1.2"/>
  <xacro:property name="y_size" value="0.91"/>
  <xacro:property name="z_size" value="0.376"/>

  <xacro:property name="mass" value="16.01"/>
      
  <!-- other props -->
  <xacro:property name="prop_mass" value="0.07"/>
  
  <!-- to set correct buoyancy volume with 1 % positive factor -->
  <xacro:property name="buoyant_correction" value="${1.01*pow((mass + 2*prop_mass)/(density*x_size*y_size*z_size), 1./3)}"/>
  <!-- Center of buoyancy -->
  <xacro:property name="z_cob" value="${-buoyant_correction*z_size/4}"/>
  <!-- Center of gravity -->
  <xacro:property name="z_cog" value="${-buoyant_correction*z_size}"/>
  
  <xacro:property name="visual_mesh_file" value="package://blueboat_description/meshes/BlueBoat.dae"/>
  <xacro:property name="collision_mesh_file" value="package://blueboat_description/meshes/BlueBoat.stl"/>

  <!-- Vehicle base link -->
    <link name="${ns}/base_link">
    <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 ${z_cog}" rpy = "${pi/2} 0 0"/>

    <!-- Inertia computed from .stl file (likely incorrect)-->   
        <!-- <inertia ixx="100.338" ixy="1.223" ixz="-3.53" iyy="70.777" iyz="1.188" izz="149.489"/> -->
    <!-- https://github.com/markusbuchholz/gazebosim_blueboat_ardupilot_sitl/blob/main/SITL_Models/Gazebo/models/blueboat/model.sdf -->
        <inertia ixx="2.42369" ixy="0" ixz="0" iyy="3.9235025" iyz="0" izz="5.6403125"/>
        
    </inertial>
    <visual>
        <origin xyz="0 -0.01 ${z_cog+0.25}" rpy = "${pi/2} 0 0"/>
        <geometry>
        <mesh filename="${visual_mesh_file}"/>
        </geometry>
        <material name="Moray Green">
            <color rgba="0.83 0.89 0.22 1"/>
        </material>
    </visual>
    
    <xacro:unless value="$(arg replay)">
    <collision>
        <origin xyz="0 0 0.05"/>
        <!-- Box adjusted for buoyancy -->
        <geometry>
            <box size="${x_size*buoyant_correction} ${y_size*buoyant_correction} ${z_size*buoyant_correction}"/>
        </geometry>
    </collision>
    </xacro:unless>

<!--    <gazebo>
        <velocity_decay>
            <linear>-250.15 -70.364 -170.955</linear>
            <angular>1.888 0.761 3.744</angular>
        </velocity_decay>
</gazebo>-->
        
    </link>
  
<xacro:unless value="$(arg replay)">
<xacro:include filename="hydrodynamics.xacro"/>
</xacro:unless>
<xacro:include filename="$(arg thrusters).xacro"/>

<xacro:if value="$(arg replay)">
    <!-- Velocity pinned to zero every physics step (VelocityControl with no
         command holds 0): a force that still reaches the hull - the simulator's
         sea-state wrench (ApplyLinkWrench) - cannot build up a velocity between
         two set_pose calls, which do not reset velocity themselves. A static
         model is not an option: set_pose does not hold one. -->
    <gazebo>
        <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    </gazebo>
    <gazebo reference="${ns}/base_link"><gravity>0</gravity></gazebo>
    <gazebo reference="${ns}/thruster1"><gravity>0</gravity></gazebo>
    <gazebo reference="${ns}/thruster2"><gravity>0</gravity></gazebo>
    <gazebo reference="${ns}/thruster3"><gravity>0</gravity></gazebo>
</xacro:if>

  
<!-- other Gazebo plugins -->
<xacro:if value="$(arg simulation)">
    <gazebo>
        <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
        
        <plugin
            filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
            <odom_frame>world</odom_frame>
            <dimensions>3</dimensions>
            <robot_base_frame>${ns}/base_link</robot_base_frame>
            <odom_publish_frequency>20</odom_publish_frequency>
        </plugin>
        
        <plugin
            filename="ignition-gazebo-pose-publisher-system"
            name="ignition::gazebo::systems::PosePublisher">
            <publish_link_pose>false</publish_link_pose>
            <publish_collision_pose>false</publish_collision_pose>
            <publish_visual_pose>false</publish_visual_pose>
            <publish_nested_model_pose>true</publish_nested_model_pose>
        </plugin>
    </gazebo>
</xacro:if>


</robot>